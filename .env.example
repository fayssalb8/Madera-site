# ═══════════════════════════════════════════════════════════════════════════════
# Madera Kitchen — Cloudflare Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# These variables should be set in the Cloudflare Dashboard:
#   Pages > madera-kitchen > Settings > Environment Variables
#
# For local development with wrangler, create a `.dev.vars` file in the
# project root (it's gitignored by default).

# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: Admin login credentials for the CRM dashboard
ADMIN_EMAIL=admin@madera.dz
ADMIN_PASSWORD=change-me-use-strong-password-min-16-chars

# REQUIRED: JWT signing secret — at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-64-char-hex-random-string

# Optional: cookie name and session duration
SESSION_COOKIE_NAME=madera_session
SESSION_MAX_AGE_MS=604800000

# ── Application ──────────────────────────────────────────────────────────────
# Canonical site URL (used for CSRF checks and SEO)
APP_ORIGIN=https://maderakitchen-dz.com

# ── Two-factor authentication (optional but recommended) ────────────────────
# Generate a secret with a TOTP app or online tool
#TOTP_SECRET=

# ── Lead notifications (fire-and-forget) ─────────────────────────────────────
# Webhook (n8n, Zapier, Make, custom): receives lead JSON on new submission.
#LEAD_NOTIFY_WEBHOOK_URL=https://hooks.example.com/madera-leads
